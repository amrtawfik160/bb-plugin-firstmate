{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "paths": { "@/*": ["./*"] },
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["server.ts", "rpc.ts", "lib/**/*.ts"],
  "exclude": ["**/*.test.ts", "node_modules", "dist"]
}
