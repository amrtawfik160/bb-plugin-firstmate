diff --git a/bin/fm-merge-local.sh b/bin/fm-merge-local.sh
index 44580de5..694e1758 100755
--- a/bin/fm-merge-local.sh
+++ b/bin/fm-merge-local.sh
@@ -96,6 +96,16 @@ default_branch() {

 BRANCH=$(grep '^branch=' "$META" | cut -d= -f2- || true)
 [ -n "$BRANCH" ] || BRANCH="fm/$ID"
+# BB names managed worktree branches. Resolve that transport-owned name while
+# retaining native's control lock, captain hold, clean-tree and ff-only gates.
+if [ "$(grep '^backend=' "$META" | cut -d= -f2-)" = bb ]; then
+  BB_WT=$(grep '^worktree=' "$META" | cut -d= -f2-)
+  [ -d "$BB_WT" ] || { echo "error: BB worktree unavailable" >&2; exit 1; }
+  BB_COMMON=$(git -C "$BB_WT" rev-parse --path-format=absolute --git-common-dir) || exit 1
+  PROJ_COMMON=$(git -C "$PROJ" rev-parse --path-format=absolute --git-common-dir) || exit 1
+  [ "$BB_COMMON" = "$PROJ_COMMON" ] || { echo "error: BB worktree belongs to another repository" >&2; exit 1; }
+  BRANCH=$(git -C "$BB_WT" symbolic-ref --quiet --short HEAD) || { echo "error: BB worktree has no branch" >&2; exit 1; }
+fi
 if ! git check-ref-format --branch "$BRANCH" >/dev/null 2>&1; then
   echo "error: task $ID has an invalid recorded ship branch '$BRANCH'" >&2
   exit 1
