#!/usr/bin/env bash
# fm-heavy <command> [args...]
# Runs a memory-heavy command (full type check, full test suite, production
# build) while holding one of FM_HEAVY_SLOTS (default 2) host-wide slots, so
# crews queue instead of pushing the shared cgroup into the OOM killer.
# A slot is an exclusive flock on $FM_HEAVY_DIR/<i>.lock held by this process;
# the kernel releases it when the process exits, so a crash leaves nothing behind.
# A waiting fm-heavy holds a flock on $FM_HEAVY_DIR/wait.<pid> the same way.
# fm-heavy --status prints "fm-heavy: <n> slots, <n> held, <n> waiting".
set -u
[ $# -gt 0 ] || { echo "usage: fm-heavy <command> [args...] | fm-heavy --status" >&2; exit 2; }

dir=${FM_HEAVY_DIR:-/tmp/fm-heavy-slots}
slots=${FM_HEAVY_SLOTS:-2}
case $slots in ''|*[!0-9]*|0) slots=2 ;; esac

if [ "$1" = --status ]; then
  command -v flock >/dev/null 2>&1 || { echo "fm-heavy: flock not found; commands run without a slot" >&2; exit 1; }
  held=0 waiting=0
  for ((i = 1; i <= slots; i++)); do
    [ -e "$dir/$i.lock" ] || continue
    { exec 9<"$dir/$i.lock"; } 2>/dev/null || continue
    flock -n 9 || held=$((held + 1))
    exec 9<&-
  done
  for file in "$dir"/wait.*; do
    [ -e "$file" ] || continue
    { exec 8<"$file"; } 2>/dev/null || continue
    # A wait file nobody locks is about to be locked, or its waiter was killed.
    if ! flock -n 8; then waiting=$((waiting + 1)); elif ! kill -0 "${file##*.}" 2>/dev/null; then rm -f "$file"; fi
    exec 8<&-
  done
  echo "fm-heavy: $slots slots, $held held, $waiting waiting"
  exit 0
fi

# A command that already runs inside a slot keeps that one slot.
[ -z "${FM_HEAVY_HELD:-}" ] || exec "$@"

if ! command -v flock >/dev/null 2>&1; then
  echo "fm-heavy: flock not found; running without a slot" >&2
  exec "$@"
fi

mkdir -p "$dir" 2>/dev/null

notified=0
while :; do
  opened=0
  for ((i = 1; i <= slots; i++)); do
    { exec 9>>"$dir/$i.lock"; } 2>/dev/null || continue
    opened=1
    flock -n 9 && break 2
    exec 9>&-
  done
  if [ "$opened" = 0 ]; then
    echo "fm-heavy: cannot open slot files in $dir; running without a slot" >&2
    exec "$@"
  fi
  if [ "$notified" = 0 ]; then
    echo "fm-heavy: waiting for a heavy-check slot" >&2
    notified=1
    { exec 8>>"$dir/wait.$$" && flock 8; } 2>/dev/null
  fi
  sleep 2 8>&-
done
if [ "$notified" = 1 ]; then
  rm -f "$dir/wait.$$"
  { exec 8>&-; } 2>/dev/null
fi

# Job control gives the command its own process group and keeps SIGINT
# deliverable to it; the lock fd is closed in the command so a daemon it
# leaves behind cannot hold the slot forever.
set -m
FM_HEAVY_HELD=1 "$@" 9>&- &
child=$!
for sig in INT TERM HUP; do
  trap "kill -$sig -- -$child 2>/dev/null" "$sig"
done
while :; do
  wait "$child"
  rc=$?
  kill -0 "$child" 2>/dev/null || exit "$rc"
done
